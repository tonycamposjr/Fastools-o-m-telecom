# Copie para .env e preencha com valores reais (nunca commite o .env!)
#   cp .env.example .env

# Porta/host do servidor da API
PORT=3001
HOST=0.0.0.0
# Em produção: NODE_ENV=production (ativa cookies Secure + HSTS)
NODE_ENV=development

# Credenciais do administrador inicial (criado no primeiro boot).
# NÃO deixe valores de exemplo em produção.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=TroqueEstaSenha_0001

# Validade da sessão em horas (padrão: 168 = 7 dias)
SESSION_TTL_HOURS=168

# Caminhos (opcionais; padrões relativos ao backend/)
# DB_PATH=./data/app.db
# UPLOAD_DIR=./uploads

# HTTPS nativo (opcional). Em produção, prefira nginx/caddy na frente.
# TLS_KEY=/etc/letsencrypt/live/seudominio/privkey.pem
# TLS_CERT=/etc/letsencrypt/live/seudominio/fullchain.pem

# Pasta do build do front-end servido pelo backend (padrão: ../dist)
# SERVE_DIST=../dist
